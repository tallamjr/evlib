   "df_s": "wall_s - sorted_s (Polars DataFrame build)",
   "frames_per_s": "frames / wall_s",
   "video_hours_per_gpu_day": "24 * video_s / wall_s",
   "stages": "CUDA per-stage seconds through the libevsim.so C ABI (unsorted call): call (host clock over the library call), stage (copy into pinned memory, single thread in the C ABI), upload, count, scan, write, sort, decode, download, device_s (count+scan+write+decode); events here come from the same LUT and match the row events except on the pre-fix runs (one-ulp LUT difference, see lib/research note)",
   "stages_sorted": "same with the device sort flag",
   "resident_ceiling_s": "whole-stack rerun on resident frames without download (wall clock), cross-check of device_s"
  },
  "cuda_levers": "rows under `cuda_levers` are the CUDA path after each Task 10 commit (raw30, batch 32/256/whole): baseline f5b9c72, lever1 bee402b (uint8 upload + device LUT), lever2 cd3e462 (pinned staging, async copies, retained buffers), lever3 8a327f9 (device radix sort), final 38afbde (parallel copy-out, in-place DataFrame conversion)"
 },
